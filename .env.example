# Production: direct Google OAuth with this project's private Blob store.
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=https://content-studio-xi-peach.vercel.app
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_RETRIES=0
# Instagram: manual Sync Instagram through Facebook Login for Business.
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# Optional migration fallback, used only if a fresh Blob read confirms no saved credential.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=1HVWVyXOxTTDQjBx3Cq-BmQ1Hr3yOTMqZRJ9avRUHQlE
# Required: password 16+ characters; random SESSION_SECRET 32+ characters.
APP_PASSWORD=
SESSION_SECRET=
GOOGLE_SHEETS_WRITES_ENABLED=false
# For a local/demo preview, unset GOOGLE_AUTH_MODE; browser demo data only:
DEMO_STORAGE=
